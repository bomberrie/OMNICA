{
  "schemaVersion": 1,
  "id": "omnica",
  "version": "${version}",
  "name": "OMNICA",
  "description": "The Vanilla-First Logistics & Supply Chain Network for Fabric.",
  "authors": [
    "Bomberrie"
  ],
  "contact": {
    "homepage": "https://github.com/Bomberrie/omnica",
    "sources": "https://github.com/Bomberrie/omnica"
  },
  "license": "MIT",
  "icon": "assets/omnica/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.omnica.Omnica"
    ],
    "client": [
      "com.omnica.client.OmnicaClient"
    ],
    "modmenu": [
      "com.omnica.client.compat.OmnicaModMenuCompat"
    ]
  },
  "mixins": [
    "omnica.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
